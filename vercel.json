{
  "cleanUrls": true,
  "functions": {
    "api/extract.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 13 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
